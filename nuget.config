<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      La fuente corporativa \\cpdfs01\itgrupopremo$\Developer\nuget no es accesible
      desde esta máquina. Este archivo anula la configuración global y define
      solo las fuentes disponibles. Elimina este archivo si vuelves a tener
      acceso a la red corporativa y necesitas esa fuente.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="LocalPackages" value="C:\NUGET" />
  </packageSources>
</configuration>
